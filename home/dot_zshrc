# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME=""
if [[ -r "${ZSH_CUSTOM:-$ZSH/custom}/themes/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  ZSH_THEME="powerlevel10k/powerlevel10k"
fi

plugins=(
git
docker
zsh-autosuggestions
zsh-defer
)

# Load only plugins installed on this machine.
_dotfiles_plugins=()
for _dotfiles_plugin in "${plugins[@]}"; do
  if [[ -r "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$_dotfiles_plugin/$_dotfiles_plugin.plugin.zsh" ||
        -r "$ZSH/plugins/$_dotfiles_plugin/$_dotfiles_plugin.plugin.zsh" ]]; then
    _dotfiles_plugins+=("$_dotfiles_plugin")
  fi
done
plugins=("${_dotfiles_plugins[@]}")
unset _dotfiles_plugins _dotfiles_plugin

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit
fi

# ==========================================
# LAZY LOADING CONFIGURATION
# ==========================================

# Syntax highlighting - load immediately after prompt (0ms delay)
_dotfiles_highlighting="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
if [[ -r "$_dotfiles_highlighting" ]]; then
  if (( $+functions[zsh-defer] )); then
    zsh-defer source "$_dotfiles_highlighting"
  else
    source "$_dotfiles_highlighting"
  fi
fi
unset _dotfiles_highlighting

# Autojump - load with small delay (0.1s)
if (( $+commands[autojump] )) && [[ -r "$ZSH/plugins/autojump/autojump.plugin.zsh" ]]; then
  if (( $+functions[zsh-defer] )); then
    zsh-defer -t 0.1 source "$ZSH/plugins/autojump/autojump.plugin.zsh"
  else
    source "$ZSH/plugins/autojump/autojump.plugin.zsh"
  fi
fi

# thefuck - load with small delay (0.2s)
if (( $+commands[thefuck] )); then
  if (( $+functions[zsh-defer] )); then
    zsh-defer -t 0.2 -c 'eval "$(thefuck --alias)"'
  else
    eval "$(thefuck --alias)"
  fi
fi

# Lazy load kubectl (on first command use)
kubectl() {
  unfunction kubectl
  [[ ! -r "$ZSH/plugins/kubectl/kubectl.plugin.zsh" ]] || source "$ZSH/plugins/kubectl/kubectl.plugin.zsh"
  kubectl "$@"
}

# Lazy load kops (on first command use)
unalias kops 2>/dev/null

kops() {
  unfunction kops
  [[ ! -r "$ZSH/plugins/kops/kops.plugin.zsh" ]] || source "$ZSH/plugins/kops/kops.plugin.zsh"
  kops "$@"
}

# Lazy load terraform (on first command use)
terraform() {
  unfunction terraform
  [[ ! -r "$ZSH/plugins/terraform/terraform.plugin.zsh" ]] || source "$ZSH/plugins/terraform/terraform.plugin.zsh"
  terraform "$@"
}

# Lazy load aws (on first command use)
aws() {
  unfunction aws
  [[ ! -r "$ZSH/plugins/aws/aws.plugin.zsh" ]] || source "$ZSH/plugins/aws/aws.plugin.zsh"
  aws "$@"
}

# Lazy load minikube completion (on first command use)
minikube() {
  if (( $+commands[minikube] )) && ! type __start_minikube >/dev/null 2>&1; then
    source <(command minikube completion zsh)
  fi
  command minikube "$@"
}

# ==========================================
# END LAZY LOADING CONFIGURATION
# ==========================================

DEFAULT_USER="Bhavesh"
prompt_context(){}

# OPTIMIZED: Lazy load kubectl/minikube completions (load only when commands are used)
# source <(kubectl completion zsh)
# source <(minikube completion zsh)

# OPTIMIZED: bashcompinit and terraform completion now lazy-loaded above
# autoload -U +X bashcompinit && bashcompinit
# complete -o nospace -C /opt/homebrew/bin/terraform terraform

[[ ! -r "$HOME/.docker/init-zsh.sh" ]] || source "$HOME/.docker/init-zsh.sh"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
# OPTIMIZED: thefuck alias disabled for faster startup (uncomment if needed)
# eval $(thefuck --alias)

# SDKMAN
export SDKMAN_DIR="$HOME/.sdkman"
if [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  unalias find 2>/dev/null
  source "$HOME/.sdkman/bin/sdkman-init.sh"
  alias find="fd"
fi
export GITHUB_PACKAGE_USERNAME=bhavesh-suvalaka

#emacs --daemon
alias e='emacsclient -t -c'

#To fix DNS resolution issues in Go programs (like kubectl), especially on macOS with certain network configurations
export GODEBUG=netdns=go

# Git worktree helpers: wt-new, wt-pr, wt-ls, wt-rm, wt-cd
[[ ! -r "$HOME/.zsh/worktree.zsh" ]] || source "$HOME/.zsh/worktree.zsh"

if [[ -r "$HOME/.config/zoxide/init.sh" ]]; then
  source "$HOME/.config/zoxide/init.sh"
elif (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# --- 1. Prompts and Shell Layout ---
(( ! $+commands[starship] )) || eval "$(starship init zsh)"

# fzf shell key bindings + completion
# source <(fzf --zsh)

if (( $+commands[brew] && $+commands[fzf] )); then
  _dotfiles_fzf_prefix="$(brew --prefix fzf 2>/dev/null)"
  if [[ -n "$_dotfiles_fzf_prefix" ]]; then
    [[ ! -r "$_dotfiles_fzf_prefix/shell/key-bindings.zsh" ]] || source "$_dotfiles_fzf_prefix/shell/key-bindings.zsh"
    [[ ! -r "$_dotfiles_fzf_prefix/shell/completion.zsh" ]] || source "$_dotfiles_fzf_prefix/shell/completion.zsh"
  fi
  unset _dotfiles_fzf_prefix
fi

[[ ! -r "$HOME/.aliases" ]] || source "$HOME/.aliases"

# --- mise--#
(( ! $+commands[mise] )) || eval "$(mise activate zsh)"

# Settings specific to this machine.
[[ ! -r "$HOME/.zshrc.local" ]] || source "$HOME/.zshrc.local"
